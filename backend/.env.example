# Copy this file to .env and fill in the values. Never commit .env.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use. Suggested: gemini-3.5-flash-lite (the free tier of gemini-3.8-flash
# allows only ~20 requests/day, about 2 runs).
LLM_MODEL=

# Optional: backup model(s), comma-separated, tried when the main one is busy.
# Suggested: gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=

# Comma-separated list of allowed frontend origins (CORS).
# Example: http://localhost:3000,https://hiremate.vercel.app
ALLOWED_ORIGINS=

# Max agent runs per IP per day on the public demo (default 10).
RATE_LIMIT_PER_DAY=
