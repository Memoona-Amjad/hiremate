# Copy this file to .env and fill in the values. Never commit .env.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use. Suggested free-tier model: gemini-3.8-flash
LLM_MODEL=

# Optional: a second model to try if the main one is rate-limited or overloaded.
# Suggested: gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=

# Comma-separated list of allowed frontend origins (CORS).
# Example: http://localhost:3000,https://hiremate.vercel.app
ALLOWED_ORIGINS=

# Max agent runs per IP per day on the public demo (default 10).
RATE_LIMIT_PER_DAY=
